---
import Hero from '@components/hero.astro'
import FeaturesTwo from '../components/featuresTwo.astro'
import Layout from '../layouts/Layout.astro'
import ProcessFlow from '../components/processFlow.astro'
import Certifications from '../components/certifications.astro'
import MachinePark from '../components/machinePark.astro'
import ContactPeople from '../components/contactPeople.astro'
import { getLocale } from 'astro-i18n-aut'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'sk' } }]
}
export const prerender = true
const locale = getLocale(Astro.url)
const homeTitle =
  locale === 'en'
    ? 'CNC Milling and Turning in Slovakia'
    : 'CNC frézovanie a sústruženie na Slovensku'
const homeDescription =
  locale === 'en'
    ? 'CNC milling and turning services in Slovakia for prototypes and small batches. Short lead times and an inspection report with every batch.'
    : 'CNC frézovanie a sústruženie na Slovensku pre prototypy a menšie série. Krátke dodacie termíny a protokol z kontroly ku každej sérii.'
---

<Layout title={homeTitle} description={homeDescription}>
  <Hero />
  <FeaturesTwo />
  <MachinePark />
  <Certifications folio={4} />
  <ProcessFlow />
  <ContactPeople folio={6} />
</Layout>
