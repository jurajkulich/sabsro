---
import { getImage } from 'astro:assets'
import { getLocale } from 'astro-i18n-aut'
import posterSrc from 'assets/hero-poster.jpg'
import Intake from './ui/intake.astro'
import { assetPath } from '../data/company'
import { parkSize, plateLabel } from '../data/machines'

const locale = getLocale(Astro.url) === 'en' ? 'en' : 'sk'
// The source footage is 960 px wide; the poster is served at its native size, never upscaled.
const poster = await getImage({ src: posterSrc, width: 960, format: 'webp', quality: 82 })

const copy = {
  en: {
    head: ['Sheet 01 · CNC machining', 'Nové Mesto nad Váhom · since 1990'],
    title: ['Your drawing.', 'Our part.'],
    body: 'A family machining shop in Nové Mesto nad Váhom. CNC milling and turning for prototypes and small series, steel to technical plastics.',
    facts: [
      ['Machining since', '1990'],
      ['People', 'a stable 20'],
      ['Production hall', '600 m²'],
      ['Machines', String(parkSize.total)],
    ],
    videoNote: 'Footage from our workshop.',
    play: 'Play footage',
    pause: 'Pause footage',
  },
  sk: {
    head: ['List 01 · CNC obrábanie', 'Nové Mesto nad Váhom · od 1990'],
    title: ['Váš výkres.', 'Náš diel.'],
    body: 'Rodinná strojárska dielňa v Novom Meste nad Váhom. CNC frézovanie a sústruženie pre prototypy a menšie série, od ocele po technické plasty.',
    facts: [
      ['Obrábame od roku', '1990'],
      ['Ľudia', 'stabilných 20'],
      ['Výrobná hala', '600 m²'],
      ['Stroje', String(parkSize.total)],
    ],
    videoNote: 'Zábery z našej dielne.',
    play: 'Prehrať video',
    pause: 'Zastaviť video',
  },
}

const t = copy[locale]
---

<div class="hero-wrap">
  <section class="hero">
    <div class="hero-field">
      <div class="hero-head" aria-hidden="true">
        <div class="hero-ticks">{Array.from({ length: 7 }, () => <span></span>)}</div>
        <p class="hero-run label">
          <span data-short={t.head[0].split(' · ')[0]}>{t.head[0]}</span>
          <span>{t.head[1]}</span>
        </p>
      </div>

      <h1 class="display hero-title" style={`--title-em: ${locale === 'en' ? 8.1 : 7.1}`}>
        {t.title.map((line) => <span>{line}</span>)}
      </h1>

      <p class="hero-body">{t.body}</p>
    </div>

    <!-- The primary action follows the headline in reading order, on every screen. -->
    <Intake class="hero-intake" />

    <div class="hero-register">
      <dl class="hero-facts">
        {
          t.facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd class="num">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="hero-photo">
      <div class="hero-media">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster={poster.src}
          aria-label={t.videoNote}
          class="hero-video plate">
          <source src={assetPath('hero.mp4')} type="video/mp4" />
        </video>
      </div>
      <figcaption>
        <span><span class="num">{plateLabel(locale, 1)}</span> · {t.videoNote}</span>
        <button
          type="button"
          class="video-toggle"
          aria-label={t.play}
          data-play={t.play}
          data-pause={t.pause}>
          <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <path class="i-play" d="M6 4.5v11l9-5.5z"></path>
            <path class="i-pause" d="M7 4.5v11M13 4.5v11"></path>
          </svg>
        </button>
      </figcaption>
    </figure>
  </section>
</div>

<script>
  // Footage autoplays only on wide screens, with motion welcome and no data saver.
  // Everyone else keeps the poster plate and can start it with the control.
  const video = document.querySelector<HTMLVideoElement>('.hero-video')
  const toggle = document.querySelector<HTMLButtonElement>('.video-toggle')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
  const wide = window.matchMedia('(min-width: 1024px)')
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData
  let userChoice: 'play' | 'pause' | null = null

  const render = () => {
    if (!video || !toggle) return
    const playing = !video.paused
    toggle.classList.toggle('is-playing', playing)
    toggle.setAttribute('aria-label', (playing ? toggle.dataset.pause : toggle.dataset.play) ?? '')
  }

  const sync = () => {
    if (!video) return
    const auto = !reduce.matches && wide.matches && !saveData
    const want = userChoice ? userChoice === 'play' : auto
    if (want && video.paused) video.play().catch(() => {})
    else if (!want && !video.paused) video.pause()
  }

  video?.addEventListener('play', render)
  video?.addEventListener('pause', render)
  toggle?.addEventListener('click', () => {
    userChoice = video?.paused ? 'play' : 'pause'
    sync()
  })
  reduce.addEventListener('change', sync)
  wide.addEventListener('change', sync)
  sync()
  render()
</script>

<style>
  .hero-wrap {
    container-type: inline-size;
  }

  .hero {
    /* Same 12-column grid as .frame, measured on the full-bleed hero. */
    --w: min(100cqw, 1440px);
    --col: calc((var(--w) - 13 * var(--gutter)) / 12);
    --edge: calc((100cqw - var(--w)) / 2 + var(--gutter));
    display: grid;
    grid-template-columns: 1fr;
  }

  /* The headline field is paper and ink. Red owns one contained module, the facts register,
     so the first view carries the logo red without the red flooding half the screen. */
  .hero-field {
    background: #fff;
    color: var(--color-ink);
  }

  .hero-register {
    background: var(--color-red);
    color: #fff;
  }

  .hero-field {
    padding: 0 var(--gutter) clamp(28px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.5vw, 48px);
  }

  .hero-head {
    display: grid;
    gap: 10px;
  }

  /* The one motion: the grid's tick line draws across the field once. Everything else paints from frame 0. */
  .hero-ticks {
    animation: wipe 1100ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: var(--gutter);
    height: 10px;
  }

  .hero-ticks span {
    border-left: 1px solid var(--color-ink);
  }

  .hero-ticks span:last-child {
    border-right: 1px solid var(--color-ink);
  }

  .hero-run {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  /*
    Display size, capped so the longest line ("Your drawing." / "Váš výkres.") stays on one line
    inside the field. --title-em is that line's width in ems, per locale.
  */
  .hero-title {
    --field: calc(100cqw - 2 * var(--gutter));
    font-size: max(2rem, min(var(--text-display), calc(var(--field) / var(--title-em))));
  }

  .hero-title span {
    display: block;
    white-space: nowrap;
  }

  .hero-body {
    max-width: 36rem;
    color: var(--color-ink);
    font-size: var(--text-lead);
    line-height: 1.45;
  }

  /* Facts register: white rules on the red module. */
  .hero-register {
    padding: 24px var(--gutter) 32px;
  }

  .hero-facts {
    border-top: 2px solid #fff;
  }

  .hero-facts > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gutter);
    padding: 9px 0;
    border-bottom: 1px solid #fff;
    font-size: var(--text-body);
  }

  .hero-facts dd {
    margin: 0;
    font-weight: 750;
  }

  /* Plate: footage over an ink caption bar carrying the plate number and the play/pause control. */
  .hero-photo {
    position: relative;
    margin: 0;
    background: var(--color-ink);
  }

  /* The box is sized by the layout only; the video (poster or playing) never sizes the hero. */
  .hero-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 0 0 var(--gutter);
    background: var(--color-ink);
    color: #fff;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .video-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #fff;
    background: var(--color-ink);
    border: 0;
    border-left: 1px solid #fff;
    transition: background-color 120ms linear;
  }

  .video-toggle:hover {
    background: var(--color-red);
  }

  .video-toggle:focus-visible {
    outline-color: #fff;
    outline-offset: -4px;
  }

  .video-toggle .i-pause,
  .video-toggle.is-playing .i-play {
    display: none;
  }

  .video-toggle.is-playing .i-pause {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ticks {
      animation: none;
    }
  }

  /* Narrow screens: only the sheet number, on the tick line; never a label stacked above the headline. */
  @media (max-width: 639px) {
    .hero-run {
      justify-content: flex-end;
    }

    .hero-run span:last-child {
      display: none;
    }

    .hero-run span:first-child {
      font-size: 0;
    }

    .hero-run span:first-child::before {
      content: attr(data-short);
      font-size: var(--text-label);
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (min-width: 640px) {
    .hero-facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
  }

  @media (min-width: 1024px) {
    /*
      Field ends in the gutter between columns 7 and 8 of the page grid.
      Row 1: headline field | footage. Row 2: facts register | intake, both opening on the same rule line.
    */
    .hero {
      grid-template-columns:
        calc(var(--edge) + 7 * var(--col) + 6.5 * var(--gutter))
        1fr;
      grid-template-rows: 1fr auto;
      min-height: clamp(640px, calc(100vh - 78px), 920px);
    }

    .hero-title {
      --field: calc(min(100cqw, 1440px) * 7 / 12 - 1.6 * var(--gutter));
    }

    .hero-field {
      grid-column: 1;
      grid-row: 1;
      padding-left: var(--edge);
      padding-right: calc(var(--gutter) / 2);
    }

    .hero-register {
      grid-column: 1;
      grid-row: 2;
      padding: clamp(24px, 2.4vw, 32px) calc(var(--gutter) / 2) clamp(28px, 3vw, 40px) var(--edge);
    }

    .hero-photo {
      grid-column: 2;
      grid-row: 1;
      display: grid;
      grid-template-rows: 1fr auto;
    }

    .hero-media {
      aspect-ratio: auto;
      min-height: 0;
    }

    .hero :global(.hero-intake) {
      grid-column: 2;
      grid-row: 2;
      --intake-pad-l: calc(var(--gutter) / 2);
      --intake-pad-r: var(--edge);
    }

    .hero-photo figcaption {
      padding-left: calc(var(--gutter) / 2);
    }
  }
</style>
