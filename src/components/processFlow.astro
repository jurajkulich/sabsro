---
import { getLocale } from 'astro-i18n-aut'
import SheetRule from './ui/sheetRule.astro'

const locale = getLocale(Astro.url) === 'en' ? 'en' : 'sk'

const copy = {
  en: {
    title: 'From drawing to delivered part.',
    body: 'Clear process, direct communication, and an inspection report with every batch.',
    steps: [
      { title: 'Inquiry review', note: 'We validate geometry, material, and tolerance stack-up.' },
      { title: 'Production plan', note: 'Tooling, fixtures, and operation sequence are prepared.' },
      { title: 'Machining', note: 'CNC milling and turning with in-process checks.' },
      { title: 'Inspection and dispatch', note: 'Final inspection report and protected shipment.' },
    ],
    op: 'Operation',
  },
  sk: {
    title: 'Od výkresu po dodaný diel.',
    body: 'Jasný postup, priama komunikácia a protokol z kontroly ku každej sérii.',
    steps: [
      { title: 'Kontrola dopytu', note: 'Overíme geometriu, materiál a tolerančný reťazec.' },
      { title: 'Plán výroby', note: 'Pripravíme náradie, prípravky a technologický postup.' },
      { title: 'Obrábanie', note: 'CNC frézovanie a sústruženie s medzioperačnou kontrolou.' },
      { title: 'Kontrola a expedícia', note: 'Výstupný protokol kvality a bezpečné balenie.' },
    ],
    op: 'Operácia',
  },
}

const t = copy[locale]
---

<section class="sheet" aria-labelledby="process-title">
  <SheetRule folio={5} />
  <div class="frame">
    <div class="grid-12 gap-y-6">
      <h2 id="process-title" class="headline col-span-12 lg:col-span-6">{t.title}</h2>
      <p class="lead col-span-12 lg:col-span-5 lg:col-start-8 lg:self-end">{t.body}</p>
    </div>

    <ol class="ops" data-procession>
      {
        t.steps.map((step, i) => (
          <li class="op">
            <span class="op-no num" aria-hidden="true">{String((i + 1) * 10).padStart(3, '0')}</span>
            <span class="sr-only">{t.op} {i + 1}: </span>
            <h3 class="op-title">{step.title}</h3>
            <p class="op-note">{step.note}</p>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<script>
  // One procession: the red track runs through the four operations once, when the list scrolls into view.
  const list = document.querySelector<HTMLElement>('[data-procession]')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (list && !reduce && 'IntersectionObserver' in window) {
    list.classList.add('is-armed')
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          list.classList.add('is-run')
          io.disconnect()
        }
      },
      { threshold: 0.5 },
    )
    io.observe(list)
  }
</script>

<style>
  .ops {
    position: relative;
    margin-top: clamp(32px, 4vw, 56px);
    display: grid;
    grid-template-columns: 1fr;
    border-top: var(--rule);
  }

  .ops::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2px;
    height: 6px;
    width: 100%;
    background: var(--color-red);
    transform-origin: left;
  }

  .ops.is-armed::before {
    transform: scaleX(0);
  }

  .ops.is-run::before {
    transform: scaleX(1);
    transition: transform 1600ms steps(4, jump-start);
  }

  .op {
    padding: 22px 0 26px;
    border-bottom: var(--soft);
  }

  .op:last-child {
    border-bottom: 0;
  }

  .op-no {
    display: block;
    font-size: var(--text-small);
    font-weight: 700;
  }

  .op-title {
    margin-top: 10px;
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .op-note {
    margin-top: 8px;
    max-width: 34ch;
    color: var(--color-mid);
    line-height: 1.5;
  }


  @media (min-width: 768px) {
    .ops {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .op {
      padding-right: var(--gutter);
      border-bottom: 0;
    }

    .op + .op {
      border-left: var(--soft);
      padding-left: var(--gutter);
    }
  }

</style>
