---
import { getLocale } from 'astro-i18n-aut'
import Arrow from './ui/arrow.astro'
import SheetRule from './ui/sheetRule.astro'
import { company, mailHref } from '../data/company'

const locale = getLocale(Astro.url) === 'en' ? 'en' : 'sk'
const { folio } = Astro.props as { folio?: number }

// Certificate details (number, issuing body, valid-until) are rendered only
// once they are filled in here. Never put placeholder values in these fields.
type Cert = {
  standard: string
  scope: { sk: string; en: string }
  certId?: string
  issuer?: string
  validTo?: string
}

const certs: Cert[] = [
  {
    standard: 'ISO 9001:2015',
    scope: { sk: 'Systém manažérstva kvality', en: 'Quality management' },
  },
  {
    standard: 'ISO 14001:2015',
    scope: { sk: 'Environmentálne manažérstvo', en: 'Environmental management' },
  },
  {
    standard: 'ISO 45001:2018',
    scope: {
      sk: 'Bezpečnosť a ochrana zdravia pri práci',
      en: 'Occupational health and safety',
    },
  },
]

const copy = {
  en: {
    title: 'Certified management systems.',
    body: 'Our production runs under three certified ISO management systems. Certificate copies are available on request.',
    cta: 'Request certificate copies',
    subject: 'Request: ISO certificate copies',
    labels: { id: 'Certificate no.', issuer: 'Issued by', valid: 'Valid until' },
  },
  sk: {
    title: 'Certifikované systémy riadenia.',
    body: 'Výroba beží podľa troch certifikovaných systémov ISO. Kópie certifikátov zašleme na požiadanie.',
    cta: 'Vyžiadať kópie certifikátov',
    subject: 'Žiadosť: kópie certifikátov ISO',
    labels: { id: 'Číslo certifikátu', issuer: 'Vydal', valid: 'Platnosť do' },
  },
}

const t = copy[locale]
---

<section class="sheet" aria-labelledby="certs-title">
  <SheetRule folio={folio} />
  <div class="frame grid-12 gap-y-10">
    <div class="col-span-12 lg:col-span-5">
      <h2 id="certs-title" class="headline">{t.title}</h2>
      <p class="lead mt-6">{t.body}</p>
      <a href={mailHref(company.email, t.subject)} class="btn btn-line mt-8">
        {t.cta}
        <Arrow />
      </a>
    </div>

    <ul class="certs col-span-12 lg:col-span-7">
      {
        certs.map((cert) => (
          <li class="cert">
            <p class="cert-std num">{cert.standard}</p>
            <p class="cert-scope">{cert.scope[locale]}</p>
            {(cert.certId || cert.issuer || cert.validTo) && (
              <dl class="cert-meta">
                {cert.certId && (
                  <div>
                    <dt class="label">{t.labels.id}</dt>
                    <dd class="num">{cert.certId}</dd>
                  </div>
                )}
                {cert.issuer && (
                  <div>
                    <dt class="label">{t.labels.issuer}</dt>
                    <dd>{cert.issuer}</dd>
                  </div>
                )}
                {cert.validTo && (
                  <div>
                    <dt class="label">{t.labels.valid}</dt>
                    <dd class="num">{cert.validTo}</dd>
                  </div>
                )}
              </dl>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs {
    border-top: var(--rule);
  }

  .cert {
    display: grid;
    gap: 4px;
    padding: 22px 0;
    border-bottom: var(--soft);
  }

  .cert:last-child {
    border-bottom: 0;
  }

  .cert-std {
    font-size: var(--text-figure);
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .cert-scope {
    color: var(--color-mid);
  }

  .cert-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 32px;
    margin-top: 8px;
  }

  .cert-meta dd {
    margin: 2px 0 0;
  }

  @media (min-width: 768px) {
    .cert {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      column-gap: var(--gutter);
      align-items: baseline;
    }

    .cert-meta {
      grid-column: 2;
    }
  }
</style>
