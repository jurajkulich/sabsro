---
import { Image } from 'astro:assets'
import Arrow from './ui/arrow.astro'
import Intake from './ui/intake.astro'
import MachineSpec from './ui/machineSpec.astro'
import SheetRule from './ui/sheetRule.astro'
import { company } from '../data/company'
import { machineFacts, machineOrder, groupLabels, parkSize, slugOf, typeOnly } from '../data/machines'

const { machs, machines, locale: rawLocale } = Astro.props
const locale = rawLocale === 'en' ? 'en' : 'sk'

const copy = {
  sk: {
    all: 'Všetky',
    filterLabel: 'Filtrovať stroje',
    indexTitle: 'Zoznam strojov',
    cols: { no: 'Č.', machine: 'Stroj', type: 'Typ', maker: 'Výrobca' },
    fallbackTitle: 'Strojové vybavenie',
    ctaTitle: 'Neviete, na ktorom stroji sa váš diel vyrobí?',
    ctaBody: `Pošlite výkres. ${company.owner.name} posúdi, kam diel patrí, a ozve sa s postupom.`,
  },
  en: {
    all: 'All',
    filterLabel: 'Filter machines',
    indexTitle: 'Machine index',
    cols: { no: 'No.', machine: 'Machine', type: 'Type', maker: 'Maker' },
    fallbackTitle: 'Machine equipment',
    ctaTitle: 'Not sure which machine your part needs?',
    ctaBody: `Send the drawing. ${company.owner.name} will check where it fits and come back with a process.`,
  },
}
const t = copy[locale]
const groups = groupLabels[locale]

const mapped = machines
  .map((item) => {
    const slug = slugOf(item.id)
    const facts = machineFacts[slug] ?? { group: 'manual' as const }
    return { item, slug, facts, n: machineOrder.indexOf(slug) + 1 || 99 }
  })
  .sort((a, b) => a.n - b.n)

const filterKeys = ['all', 'cnc', 'manual', 'saw'] as const
const counts = Object.fromEntries(
  filterKeys.map((k) => [k, k === 'all' ? mapped.length : mapped.filter((x) => x.facts.group === k).length]),
)
const filterLabel = (k: (typeof filterKeys)[number]) => (k === 'all' ? t.all : groups[k])
const pad = (n: number) => String(n).padStart(2, '0')
// The page title states the whole park's size ("{count} machines in our hall."); the index below lists a selection.
const pageTitle = machs.data.title.replace('{count}', String(parkSize.total))
---

<section class="sheet-first">
  <SheetRule folio={1} />
  <div class="frame grid-12 gap-y-6">
    <h1 class="display page-title col-span-12 lg:col-span-7">{pageTitle}</h1>
    <p class="lead col-span-12 max-w-2xl lg:col-span-5 lg:self-end">{machs.data.description}</p>
  </div>
</section>

<section class="sheet" aria-labelledby="index-title">
  <SheetRule folio={2} />
  <div class="frame">
    <h2 id="index-title" class="sr-only">{t.indexTitle}</h2>
    <!-- Filters only work with the script, so they stay hidden until it runs. -->
    <div class="filters" role="group" aria-label={t.filterLabel} hidden>
      {
        filterKeys
          .filter((key) => counts[key] > 0)
          .map((key, idx) => (
            <button type="button" data-filter={key} aria-pressed={idx === 0 ? 'true' : 'false'}>
              {filterLabel(key)} <span class="num">{counts[key]}</span>
            </button>
          ))
      }
    </div>

    <div class="idx-head" aria-hidden="true">
      <span></span><span>{t.cols.no}</span><span>{t.cols.machine}</span><span>{t.cols.type}</span><span>{t.cols.maker}</span><span></span>
    </div>
    <ul class="index">
      {
        mapped.map(({ item, slug, facts, n }) => {
          const type = typeOnly(item.data.title) || t.fallbackTitle
          return (
            <li id={slug} data-category={facts.group}>
              <details name="machine">
                <summary class="idx-row">
                  <span class="idx-thumb">
                    <Image src={item.data.avatar.src} alt="" width={160} height={120} fit="contain" loading="lazy" class="plate" />
                  </span>
                  <span class="idx-no num">{pad(n)}</span>
                  <span class="idx-name">{item.data.name}</span>
                  <span class="idx-type">{type}</span>
                  <span class="idx-maker">{facts.maker ?? ''}</span>
                  <Arrow class="idx-arrow" dir="down" />
                </summary>
                <MachineSpec item={item} slug={slug} locale={locale} />
              </details>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>

<section class="ask" aria-labelledby="ask-title">
  <SheetRule folio={3} tone="white" />
  <div class="frame grid-12 gap-y-8">
    <div class="col-span-12 lg:col-span-6">
      <h2 id="ask-title" class="display ask-title">{t.ctaTitle}</h2>
      <p class="lead mt-6">{t.ctaBody}</p>
    </div>
    <Intake tone="red" note="brief" class="col-span-12 lg:col-span-5 lg:col-start-8 lg:self-end" />
  </div>
</section>

<script>
  const filters = document.querySelector<HTMLElement>('.filters')
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters button'))
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.index > li'))
  const apply = (filter: string) => {
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter)))
    rows.forEach((row) => {
      row.hidden = filter !== 'all' && row.dataset.category !== filter
    })
  }
  if (filters) filters.hidden = false
  buttons.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all')))

  // Deep link: /machines#mcv1016 opens that machine's spec sheet. If the active filter hides
  // the row, fall back to "all" first so the opened sheet is never inside a hidden row.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1))
    const row = id ? document.getElementById(id) : null
    const details = row?.querySelector('details')
    if (!row || !details) return
    if (row.hidden) apply('all')
    details.open = true
    row.scrollIntoView({ block: 'start' })
  }
  openFromHash()
  window.addEventListener('hashchange', openFromHash)

  // Keep the address in step with the open sheet, so it can be copied and shared.
  rows.forEach((row) => {
    row.querySelector('details')?.addEventListener('toggle', (event) => {
      const details = event.currentTarget as HTMLDetailsElement
      if (details.open) history.replaceState(null, '', `#${row.id}`)
      else if (location.hash === `#${row.id}`) history.replaceState(null, '', location.pathname + location.search)
    })
  })
</script>

<style>
  .page-title {
    font-size: var(--text-page-title);
  }

  .filters {
    display: inline-flex;
    flex-wrap: wrap;
    border: var(--hair);
  }

  .filters[hidden] {
    display: none;
  }

  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    font-weight: 700;
    color: var(--color-ink);
    background: #fff;
  }

  .filters button + button {
    border-left: var(--hair);
  }

  .filters button .num {
    font-weight: 500;
    color: var(--color-mid);
  }

  .filters button:hover {
    background: var(--color-stone);
  }

  .filters button[aria-pressed='true'] {
    background: var(--color-ink);
    color: #fff;
  }

  .filters button[aria-pressed='true'] .num {
    color: #fff;
  }

  .idx-head,
  .idx-row {
    display: grid;
    grid-template-columns: 72px 2rem minmax(0, 1fr) 20px;
    column-gap: var(--gutter);
    align-items: center;
  }

  .idx-head {
    display: none;
    margin-top: 28px;
    padding-bottom: 10px;
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .index {
    margin-top: 24px;
    border-top: var(--rule);
  }

  .index > li {
    border-bottom: var(--soft);
    scroll-margin-top: 96px;
  }

  .index > li:last-child {
    border-bottom: 0;
  }

  .idx-row {
    list-style: none;
    cursor: pointer;
    padding: 10px 0;
  }

  .idx-row::-webkit-details-marker {
    display: none;
  }

  .idx-row:hover .idx-name,
  details[open] .idx-name {
    color: var(--color-red);
  }

  .idx-thumb {
    grid-row: 1 / 3;
    height: 54px;
    display: grid;
    place-items: center;
  }

  .idx-thumb :global(img) {
    height: 54px;
    width: 72px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .idx-no {
    grid-row: 1 / 3;
    font-weight: 700;
  }

  .idx-name {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }

  .idx-type {
    grid-column: 3;
    font-size: var(--text-small);
    color: var(--color-mid);
  }

  .idx-maker {
    display: none;
  }

  .idx-row :global(.idx-arrow) {
    grid-column: 4;
    grid-row: 1 / 3;
    transition:
      transform 160ms ease-out,
      rotate 200ms ease-out;
  }

  details:not([open]) > .idx-row:hover :global(.idx-arrow) {
    transform: translateY(3px);
  }

  details[open] .idx-row :global(.idx-arrow) {
    rotate: -90deg !important;
  }

  .ask {
    margin-top: clamp(16px, 3vw, 40px);
    background: var(--color-red);
    color: #fff;
    padding-bottom: clamp(48px, 7vw, 104px);
  }

  .ask > :global(.sheet-rule) {
    margin-bottom: clamp(36px, 6vw, 88px);
  }

  .ask-title {
    font-size: var(--text-statement);
    text-wrap: balance;
  }

  .ask :global(:focus-visible) {
    outline-color: #fff;
  }

  @media (min-width: 900px) {
    .idx-head {
      display: grid;
    }

    /* The column head is only shown here, so only here does the list tuck under it. */
    .idx-head + .index {
      margin-top: 0;
    }

    .idx-head,
    .idx-row {
      grid-template-columns: 72px 2.5rem minmax(0, 3fr) minmax(0, 4fr) minmax(0, 1.4fr) 20px;
    }

    .idx-thumb,
    .idx-no,
    .idx-row :global(.idx-arrow) {
      grid-row: auto;
    }

    .idx-type {
      grid-column: auto;
    }

    .idx-maker {
      display: block;
      font-size: var(--text-small);
      font-weight: 600;
    }

    .idx-row :global(.idx-arrow) {
      grid-column: 6;
    }

  }
</style>
