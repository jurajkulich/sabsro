---
import { Image } from 'astro:assets'
import plates from 'assets/carousel/carousel_3.jpg'
import ContactPeople from './contactPeople.astro'
import Arrow from './ui/arrow.astro'
import SheetRule from './ui/sheetRule.astro'
import { company, localizedPath } from '../data/company'

const { about, locale: rawLocale } = Astro.props
const locale = rawLocale === 'en' ? 'en' : 'sk'

// Figures come from the About copy below (PRODUCT.md › Positioning). Keep them in step with the hero.
const copy = {
  sk: {
    lead: 'Rodinná strojárska firma, stabilných 20 ľudí. CNC a klasické obrábanie kovov a plastov, prototypy a menšie série.',
    registerTitle: 'Firma v číslach',
    register: [
      ['Obchodné meno', company.legalName],
      ['História od roku', '1990'],
      ['Založená', '2012 ako Švehla s.r.o.'],
      ['Ľudia', 'stabilných 20'],
      ['Výrobná hala', '600 m²'],
      ['Sklad materiálu a reziareň', '600 m²'],
      ['IČO', company.ids.ico],
      ['DIČ', company.ids.dic],
    ],
    storyTitle: 'O firme',
    rows: { p1: 'História', p2: 'Ľudia a priestory', p3: 'Čo robíme' },
    caption: 'Séria vŕtaných dosiek z našej výroby.',
    machines: 'Pozrieť strojový park',
  },
  en: {
    lead: 'A family engineering company with a stable team of 20 people. CNC and conventional machining of metals and plastics, prototypes and small series.',
    registerTitle: 'The company in figures',
    register: [
      ['Registered name', company.legalName],
      ['History since', '1990'],
      ['Founded', '2012 as Švehla s.r.o.'],
      ['People', 'a stable 20'],
      ['Production hall', '600 m²'],
      ['Stock and cutting room', '600 m²'],
      ['Company ID (IČO)', company.ids.ico],
      ['VAT ID (DIČ)', company.ids.dic],
    ],
    storyTitle: 'About the company',
    rows: { p1: 'History', p2: 'People and premises', p3: 'What we do' },
    caption: 'A batch of drilled plates from our shop.',
    machines: 'See the machine park',
  },
}
const t = copy[locale]
const rows = [
  { title: t.rows.p1, body: about.data.subtitle1 },
  { title: t.rows.p2, body: about.data.subtitle2 },
  { title: t.rows.p3, body: about.data.subtitle3 },
]
---

<section class="sheet-first">
  <SheetRule folio={1} />
  <div class="frame grid-12 gap-y-12">
    <div class="col-span-12 lg:col-span-7">
      <h1 class="display page-title">{about.data.title}</h1>
      <p class="lead mt-6 lg:mt-8">{t.lead}</p>
    </div>

    <div class="col-span-12 lg:col-span-5 lg:col-start-8">
      <h2 class="label">{t.registerTitle}</h2>
      <dl class="register">
        {
          t.register.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd class="num">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<section class="sheet" aria-labelledby="story-title">
  <SheetRule folio={2} />
  <div class="frame grid-12 gap-y-12">
    <div class="col-span-12 lg:col-span-7">
      <h2 id="story-title" class="sr-only">{t.storyTitle}</h2>
      <dl class="story">
        {
          rows.map((row) => (
            <div>
              <dt>{row.title}</dt>
              <dd>{row.body}</dd>
            </div>
          ))
        }
      </dl>
      <a href={localizedPath(locale, 'machines')} class="btn btn-line mt-8">
        {t.machines}
        <Arrow />
      </a>
    </div>

    <figure class="col-span-12 m-0 sm:col-span-8 lg:col-span-4 lg:col-start-9 about-figure">
      <Image src={plates} alt={t.caption} width={900} height={1125} fit="cover" loading="eager" class="plate about-photo" />
      <figcaption class="mt-3 text-small text-mid">{t.caption}</figcaption>
    </figure>
  </div>
</section>

<ContactPeople folio={3} />

<style>
  .page-title {
    font-size: var(--text-page-title);
  }

  .about-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .about-figure {
      position: sticky;
      top: 24px;
      align-self: start;
    }
  }

  .register {
    margin-top: 10px;
    border-top: var(--rule);
  }

  .register > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gutter);
    padding: 12px 0;
    border-bottom: var(--soft);
  }

  .register > div:last-child {
    border-bottom: 0;
  }

  .register dt {
    color: var(--color-mid);
  }

  .register dd {
    margin: 0;
    font-weight: 700;
  }

  /* The sheet rule above already opens this list; a second heavy rule would double it. */
  .story > div {
    display: grid;
    gap: 8px;
    padding: 22px 0;
    border-bottom: var(--soft);
  }

  .story > div:first-child {
    padding-top: 0;
  }

  .story > div:last-child {
    border-bottom: 0;
  }

  .story dt {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }

  .story dd {
    margin: 0;
    max-width: 65ch;
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  /* Title over body: in seven columns a side-by-side split would squeeze the copy. */
</style>
