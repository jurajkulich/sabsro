---
import { Image } from 'astro:assets'
import Arrow from './ui/arrow.astro'
import SheetRule from './ui/sheetRule.astro'
import type { Part } from '../data/parts'

type Item = Part & { full: { src: string }; views: { src: string; width: number }[]; ratio: number }
const { locale: rawLocale, items } = Astro.props as { locale: string; items: Item[] }
const locale = rawLocale === 'en' ? 'en' : 'sk'

const copy = {
  sk: {
    title: 'Ukážky z našej výroby.',
    lead: 'Diely, ktoré sme vyrobili podľa výkresov našich zákazníkov, od jedného kusu po menšie série.',
    registerTitle: 'Ukážky dielov',
    material: 'Materiál',
    process: 'Postup',
    enlarge: 'Zväčšiť fotografiu',
    viewer: 'Prehliadač fotografií',
    close: 'Zavrieť',
    prev: 'Predchádzajúca fotografia',
    next: 'Ďalšia fotografia',
  },
  en: {
    title: 'Examples of our work.',
    lead: 'Parts we have made to our customers’ drawings, from one-offs to small series.',
    registerTitle: 'Example parts',
    material: 'Material',
    process: 'Process',
    enlarge: 'Enlarge photo',
    viewer: 'Photo viewer',
    close: 'Close',
    prev: 'Previous photo',
    next: 'Next photo',
  },
}
const t = copy[locale]
const pad = (n: number) => String(n).padStart(2, '0')
---

<section class="sheet-first">
  <SheetRule folio={1} />
  <div class="frame grid-12 gap-y-6">
    <h1 class="display page-title col-span-12 lg:col-span-7">{t.title}</h1>
    <p class="lead col-span-12 max-w-2xl lg:col-span-5 lg:self-end">{t.lead}</p>
  </div>
</section>

<section class="sheet" aria-labelledby="register-title">
  <SheetRule folio={2} />
  <div class="frame">
    <h2 id="register-title" class="sr-only">{t.registerTitle}</h2>
    <ul class="register">
      {
        items.map((item, i) => (
          <li>
            <figure class="m-0">
              <a
                href={item.full.src}
                class="plate-link"
                aria-label={`${t.enlarge}: ${item.name[locale]}`}
                data-views={item.views.map((v) => `${v.src} ${v.width}`).join(', ')}
                data-ratio={item.ratio.toFixed(4)}
              >
                <Image
                  src={item.src}
                  alt={`${item.name[locale]}, ${item.material[locale].toLowerCase()}`}
                  width={720}
                  height={900}
                  fit="cover"
                  position={item.position}
                  widths={[360, 540, 720]}
                  sizes="(min-width: 1100px) 330px, 46vw"
                  loading={i < 4 ? 'eager' : 'lazy'}
                  class="plate"
                />
              </a>
              <figcaption>
                <p class="part-name">
                  <span class="part-no num">{pad(i + 1)}</span>
                  <span class="part-title">{item.name[locale]}</span>
                </p>
                <dl class="part-facts">
                  <div>
                    <dt>{t.material}</dt>
                    <dd>{item.material[locale]}</dd>
                  </div>
                  <div>
                    <dt>{t.process}</dt>
                    <dd>{item.process[locale]}</dd>
                  </div>
                </dl>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Photo viewer. Without the script the plate links simply open the large image. -->
<dialog class="viewer" aria-label={t.viewer} tabindex="-1">
  <div class="viewer-bar frame">
    <p class="viewer-name" aria-live="polite"></p>
    <button type="button" class="viewer-close label" data-close>{t.close}</button>
  </div>
  <div class="viewer-stage" data-close></div>
  <div class="viewer-foot frame">
    <dl class="viewer-facts"></dl>
    <div class="viewer-nav">
      <button type="button" data-step="-1" aria-label={t.prev}><Arrow dir="left" /></button>
      <button type="button" data-step="1" aria-label={t.next}><Arrow /></button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.viewer')
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.register > li'))

  if (dialog && rows.length) {
    // The viewer's image is created here, so the markup never ships an <img> without a source.
    const img = document.createElement('img')
    img.className = 'viewer-img'
    img.decoding = 'async'
    dialog.querySelector('.viewer-stage')!.append(img)
    const stage = dialog.querySelector<HTMLElement>('.viewer-stage')!
    const name = dialog.querySelector<HTMLElement>('.viewer-name')!
    const facts = dialog.querySelector<HTMLElement>('.viewer-facts')!
    const entries = rows.map((row) => {
      const link = row.querySelector<HTMLAnchorElement>('.plate-link')!
      return {
        link,
        ratio: Number(link.dataset.ratio) || 0.5625,
        // "url width, url width", smallest first; the anchor's own href (the largest) is the fallback.
        views: (link.dataset.views ?? '')
          .split(', ')
          .map((v) => v.split(' '))
          .filter(([src, w]) => src && w)
          .map(([src, w]) => ({ src, width: Number(w) })),
        alt: row.querySelector('img')?.alt ?? '',
        no: row.querySelector('.part-no')?.textContent ?? '',
        name: row.querySelector('.part-title')?.textContent ?? '',
        facts: Array.from(row.querySelectorAll('.part-facts > div')).map((d) => [
          d.querySelector('dt')?.textContent ?? '',
          d.querySelector('dd')?.textContent ?? '',
        ]),
      }
    })
    let current = 0
    let token = 0

    // The smallest rendering that covers the photo as the stage draws it (object-fit: contain).
    // Density is capped at 2x: past that a photo looks the same and only costs bytes.
    const pick = (e: (typeof entries)[number]) => {
      const box = stage.getBoundingClientRect()
      const w = box.width || window.innerWidth
      const h = box.height || window.innerHeight
      const need = Math.min(w, h * e.ratio) * Math.min(window.devicePixelRatio || 1, 2)
      return e.views.find((v) => v.width >= need)?.src ?? e.link.href
    }

    const preload = (i: number) => {
      const e = entries[(i + entries.length) % entries.length]
      new Image().src = pick(e)
    }

    const show = (i: number) => {
      current = (i + entries.length) % entries.length
      const e = entries[current]
      const mine = ++token
      const no = document.createElement('span')
      no.className = 'viewer-no num'
      no.textContent = e.no
      name.replaceChildren(no, ' ', e.name)
      facts.replaceChildren(
        ...e.facts.map(([k, v]) => {
          const div = document.createElement('div')
          const dt = document.createElement('dt')
          const dd = document.createElement('dd')
          dt.textContent = k
          dd.textContent = v
          div.append(dt, dd)
          return div
        }),
      )
      // Swap only once the new photo is decoded, so the stage never flashes empty.
      const src = pick(e)
      const next = new Image()
      next.src = src
      dialog.classList.add('is-loading')
      next
        .decode()
        .catch(() => {})
        .finally(() => {
          if (mine !== token) return
          img.src = src
          img.alt = e.alt
          dialog.classList.remove('is-loading')
        })
      preload(current + 1)
      preload(current - 1)
    }

    entries.forEach((e, i) =>
      e.link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        event.preventDefault()
        // Open first so the stage has its real size when the rendering is picked.
        dialog.showModal()
        show(i)
        dialog.focus()
      }),
    )

    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
      btn.addEventListener('click', () => show(current + Number(btn.dataset.step))),
    )

    // Close on the button, or on the stage around the photo (not on the photo itself).
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement
      if (target.hasAttribute('data-close')) dialog.close()
    })

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(current + 1)
      if (event.key === 'ArrowLeft') show(current - 1)
    })

    let startX = 0
    let startY = 0
    dialog.addEventListener('touchstart', (event) => {
      startX = event.touches[0].clientX
      startY = event.touches[0].clientY
    }, { passive: true })
    dialog.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - startX
      const dy = event.changedTouches[0].clientY - startY
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1))
    })
  }
</script>

<style>
  /* The viewer: the photo on a full ink field, its name above and its facts below. No box, no shadow. */
  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-ink);
    color: #fff;
  }

  .viewer:focus {
    outline: none;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .viewer::backdrop {
    background: var(--color-ink);
  }

  .viewer :global(:focus-visible) {
    outline-color: #fff;
  }

  .viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
    min-height: 64px;
    border-bottom: 2px solid #fff;
  }

  .viewer-name {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .viewer-no {
    margin-right: 0.35em;
    font-weight: 700;
    font-stretch: 100%;
  }

  .viewer-close {
    min-height: 44px;
    padding: 0 0 0 12px;
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  /* The photo is pinned inside the stage and letterboxed, so any orientation fits the screen whole. */
  .viewer-stage {
    --stage-pad: clamp(12px, 2vw, 28px);
    position: relative;
    min-height: 0;
  }

  .viewer-stage :global(.viewer-img) {
    position: absolute;
    top: var(--stage-pad);
    left: var(--gutter);
    width: calc(100% - 2 * var(--gutter));
    height: calc(100% - 2 * var(--stage-pad));
    object-fit: contain;
    transition: opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .viewer.is-loading :global(.viewer-img) {
    opacity: 0.35;
  }

  .viewer-foot {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--gutter);
    padding-top: 12px;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-mid);
  }

  .viewer-facts {
    display: grid;
    gap: 6px var(--gutter);
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .viewer-facts :global(dt) {
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .viewer-facts :global(dd) {
    margin: 2px 0 0;
  }

  .viewer-nav {
    display: flex;
    flex: none;
    align-self: center;
    border: 1px solid #fff;
  }

  .viewer-nav button {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    color: #fff;
  }

  .viewer-nav button + button {
    border-left: 1px solid #fff;
  }

  .viewer-nav button:hover {
    background: #fff;
    color: var(--color-ink);
  }

  @media (min-width: 760px) {
    .viewer-facts {
      grid-template-columns: repeat(2, minmax(0, max-content));
      column-gap: clamp(24px, 4vw, 64px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer-stage :global(.viewer-img) {
      transition: none;
    }
  }

  .page-title {
    font-size: var(--text-page-title);
  }

  /* Each example carries its running number, set like the machine index. Rules, no boxes.
     Two columns even on a phone, so the photos read as one sheet rather than a long feed. */
  .register {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    /* No row gap: a subgrid still sits on its parent's gaps, which would open up between name, material
       and process. The space between rows of entries is each entry's own padding instead. */
    row-gap: 0;
  }

  .register > li {
    padding-bottom: clamp(28px, 4vw, 56px);
  }

  .plate-link {
    display: block;
    cursor: zoom-in;
  }

  .plate-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .plate-link:focus-visible {
    outline-offset: 3px;
  }

  /* Every entry shares its row's tracks (photo, name, material, process), so names and facts that wrap
     to different lengths still line up across the row, on a phone as on a desktop. */
  .register > li,
  .register figure {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: 0;
  }

  .register figure {
    grid-row: 1 / -1;
  }

  .register figcaption,
  .part-facts {
    display: grid;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  .register figcaption {
    grid-row: span 3;
  }

  .part-facts {
    grid-row: span 2;
  }

  /* The name hangs right under the photo; the rule closes the row's tallest name, so a shorter name
     leaves its air below the text and the facts start level across the row. */
  .part-name {
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom: var(--hair);
    font-size: var(--text-body);
    font-weight: 750;
    font-stretch: 112%;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .part-name {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }

  .part-no {
    flex: none;
    font-weight: 700;
    font-stretch: 100%;
  }

  li:has(.plate-link:hover) .part-title {
    color: var(--color-red);
  }

  .part-facts > div {
    padding: 3px 0 4px;
    border-bottom: var(--soft);
    font-size: var(--text-small);
    line-height: 1.3;
  }

  .part-facts dt {
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .part-facts dd {
    margin: 0;
  }

  @media (min-width: 760px) {
    .part-name {
      padding-top: 12px;
      padding-bottom: 10px;
      font-size: var(--text-lead);
    }

    .part-facts > div {
      padding: 4px 0 5px;
      line-height: 1.35;
    }
  }

  @media (min-width: 1100px) {
    .register {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
