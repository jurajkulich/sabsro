---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import { getLocale } from 'astro-i18n-aut'
import SheetRule from './ui/sheetRule.astro'
import { localizedPath } from '../data/company'
import { firstSlugOf } from '../data/machines'
import Arrow from './ui/arrow.astro'
import { parts as partsRegister } from '../data/parts'

const locale = getLocale(Astro.url) === 'en' ? 'en' : 'sk'
const features = await getEntry('features', locale + '/features')
if (!features) throw new Error(`Missing features content for ${locale}`)

const copy = {
  en: {
    deliverables:
      'Typical work: production fixtures and jigs, ground shafts, replacement parts for all kinds of uses, and slotting keyways, for example in gears.',
    register: [
      [
        'Materials',
        'All grades of steel and stainless steel, aluminium and copper alloys, technical plastics',
      ],
      [
        'We supply',
        'Energy, food processing, agriculture, automation lines, spare parts, fixtures and clamping, one-off parts, machining of moulded plastic parts, robotics, healthcare and other industries',
      ],
    ],
    cols: ['No.', 'Service', 'Machines'],
    groups: { shop: 'In our hall', around: 'Finishing and delivery' },
    machinesLabel: 'Machines',
    newLabel: 'New',
    partsTitle: 'Parts from our shop',
    allParts: 'More examples',
  },
  sk: {
    deliverables:
      'Typické zákazky: rôzne prípravky do výroby, brúsené hriadele a náhradné diely pre rôzne využitie, obrážanie drážok napríklad do ozubených kolies.',
    register: [
      [
        'Materiály',
        'Všetky triedy ocele aj nehrdzavejúcej ocele, zliatiny hliníka a medi, technické plasty',
      ],
      [
        'Pre koho',
        'Energetika, potravinárstvo, poľnohospodárstvo, automatizačné linky, náhradné diely, prípravky a upínanie, kusové diely, opracovanie lisovaných plastových dielov, robotizácia, zdravotníctvo a iné odvetvia',
      ],
    ],
    cols: ['Č.', 'Služba', 'Stroje'],
    groups: { shop: 'V našej hale', around: 'Povrchové úpravy a doprava' },
    machinesLabel: 'Stroje',
    newLabel: 'Novinka',
    partsTitle: 'Diely z našej dielne',
    allParts: 'Ďalšie ukážky',
  },
}

const t = copy[locale]
const machinesPath = localizedPath(locale, 'machines')
// The home page shows the first four examples; the rest live on /parts.
const homeParts = partsRegister.slice(0, 4).map((part) => ({ src: part.src, caption: part.name[locale] }))

// Descriptions may mark a phrase with **double asterisks**; odd parts after the split render bold.
const emphasis = (text: string) => text.split(/\*\*(.+?)\*\*/)

// One numbered register, set as two short lists: what we machine ourselves, then what happens around the part.
const numbered = features.data.features.map((item, i) => ({ item, n: i + 1 }))
const groups = (['shop', 'around'] as const)
  .map((key) => ({
    key,
    rows: numbered.filter(({ item }) => (item.group ?? 'shop') === key),
  }))
  .filter((g) => g.rows.length > 0)
---

<section class="sheet" aria-labelledby="services-title">
  <SheetRule folio={2} />
  <div class="frame">
    <div class="grid-12 gap-y-6">
      <h2 id="services-title" class="headline col-span-12 lg:col-span-6">
        {features.data.title}
      </h2>
      <div class="col-span-12 lg:col-span-5 lg:col-start-8">
        <p class="lead">{features.data.description}</p>
        <p class="mt-4 text-mid">{t.deliverables}</p>
      </div>
    </div>

    {groups.map((group, gi) => (
      <div class="svc-group">
        <div class="svc-head">
          <h3 class="label svc-group-title">{t.groups[group.key]}</h3>
          {gi === 0 && (
            <span class="svc-col" aria-hidden="true">
              {t.cols[2]}
            </span>
          )}
        </div>
        <ol class="svc" start={group.rows[0].n}>
          {group.rows.map(({ item, n }) => (
            <li class="svc-row">
              <span class="svc-no num" aria-hidden="true">
                {String(n).padStart(2, '0')}
              </span>
              <h4 class="svc-name">
                {item.title}
                {item.new && <span class="svc-new label">{t.newLabel}</span>}
              </h4>
              <p class="svc-desc">
                {emphasis(item.description).map((part, i) =>
                  i % 2 ? <strong>{part}</strong> : part,
                )}
              </p>
              {item.machines && (
                <p class="svc-machines num">
                  <a
                    href={`${machinesPath}#${firstSlugOf(item.machines) ?? ''}`}
                    class="link">
                    <span class="svc-machines-label">{t.machinesLabel} </span>
                    <span class="svc-machines-no">{item.machines}</span>
                  </a>
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}

    <dl class="reg">
      {t.register.map(([k, v]) => (
        <div>
          <dt class="label">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>

    <div class="parts-head">
      <h3 class="label">{t.partsTitle}</h3>
      <a href={localizedPath(locale, 'parts')} class="parts-all link">
        {t.allParts}
        <Arrow />
      </a>
    </div>
    <ul class="parts">
      {homeParts.map((part, i) => (
        <li>
          <figure class="m-0">
            <Image
              src={part.src}
              alt={part.caption}
              width={640}
              height={800}
              fit="cover"
              loading="lazy"
              class="plate aspect-4/5 w-full object-cover"
            />
            <figcaption>
              {part.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .text-mid {
    max-width: 36rem;
    line-height: 1.5;
    color: var(--color-mid);
  }

  /* Services: a numbered register in two short lists. Number, name, what it is, which machines do it. */
  .svc-group {
    margin-top: clamp(32px, 4vw, 56px);
  }

  .svc-group + .svc-group {
    margin-top: clamp(24px, 3vw, 40px);
  }

  .svc-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gutter);
    padding-bottom: 10px;
  }

  .svc-col {
    display: none;
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .svc {
    border-top: var(--rule);
  }

  .svc-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    column-gap: var(--gutter);
    align-items: baseline;
    padding: 14px 0 16px;
    border-bottom: var(--soft);
  }

  /* The list ends in space; the next 2px rule closes it, so no hairline doubles it. */
  .svc-row:last-child {
    border-bottom: 0;
  }

  .svc-no {
    font-weight: 700;
  }

  .svc-name {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  /* A stamp, not a badge: full-strength red field, paper type, square. It sits above the name,
     out of flow, so the number, name and description keep sharing one baseline. */
  .svc-row:has(.svc-new) {
    padding-top: 40px;
  }

  .svc-name {
    position: relative;
  }

  .svc-new {
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
    padding: 3px 6px 2px;
    background: var(--color-red);
    color: var(--color-paper);
    font-stretch: 100%;
    line-height: 1;
    white-space: nowrap;
  }

  .svc-desc {
    grid-column: 2 / 4;
    margin-top: 4px;
    max-width: 62ch;
    color: var(--color-mid);
    line-height: 1.5;
  }

  /* Narrow screens have no column head, so the link carries its own label under the description. */
  .svc-machines {
    grid-column: 2 / 4;
    margin-top: 6px;
    font-weight: 700;
    white-space: nowrap;
  }

  .svc-machines-no {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: inherit;
  }

  .svc-machines a:hover .svc-machines-no {
    text-decoration-color: var(--color-red);
  }

  /* inline-block keeps the link's underline on the numbers only. */
  .svc-machines-label {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 6px;
  }

  /* The machine numbers are a link: give the thumb a full-height target. */
  .svc-machines a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    margin-block: -8px;
  }

  /* Materials and industries: one register, two rows. */
  .reg {
    margin-top: clamp(28px, 3vw, 40px);
    border-top: var(--rule);
  }

  .reg > div {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    border-bottom: var(--soft);
  }

  .reg > div:last-child {
    border-bottom: 0;
  }

  .reg dt {
    color: var(--color-mid);
  }

  .reg dd {
    margin: 0;
  }

  .parts-head {
    margin-top: clamp(40px, 5vw, 64px);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gutter);
  }

  .parts-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
  }

  .parts-all :global(svg) {
    align-self: center;
    transition: transform 160ms ease-out;
  }

  .parts-all:hover :global(svg) {
    transform: translateX(3px);
  }

  .parts {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    border-top: var(--rule);
    padding-top: var(--gutter);
  }

  .parts figcaption {
    margin-top: 8px;
    font-size: var(--text-small);
    color: var(--color-mid);
  }

  @media (min-width: 900px) {
    .svc-col {
      display: block;
      /* Sits over the Machines column of the rows below. */
      width: calc((100% - 2.5rem - 3 * var(--gutter)) * 1.2 / 9.2);
    }

    .svc-row {
      grid-template-columns: 2.5rem minmax(0, 3fr) minmax(0, 5fr) minmax(
          0,
          1.2fr
        );
    }

    .svc-desc {
      grid-column: 3;
      margin-top: 0;
    }

    .svc-machines {
      grid-column: 4;
      grid-row: auto;
      margin-top: 0;
    }

    .svc-machines a {
      margin-block: -12px;
    }

    /* The column head names the column from here on; the label stays for screen readers. */
    .svc-machines-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .reg > div {
      /* Key column ends where the service name column ends, so values align with the descriptions. */
      grid-template-columns:
        calc(
          2.5rem + var(--gutter) + (100% - 2.5rem - 3 * var(--gutter)) * 3 / 9.2
        )
        1fr;
      column-gap: var(--gutter);
    }
  }

  @media (min-width: 1024px) {
    .parts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
