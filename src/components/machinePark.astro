---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { getLocale } from 'astro-i18n-aut'
import Arrow from './ui/arrow.astro'
import MachineSpec from './ui/machineSpec.astro'
import SheetRule from './ui/sheetRule.astro'
import { localizedPath } from '../data/company'
import { machineFacts, machineOrder, slugOf, typeOnly } from '../data/machines'

const locale = getLocale(Astro.url) === 'en' ? 'en' : 'sk'

const all = await getCollection(
  'team',
  ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft,
)

// The home sheet shows the index's CNC rows; each opens its spec sheet in place, as on /machines.
const featured = machineOrder
  .filter((slug) => machineFacts[slug].group === 'cnc')
  .map((slug) => all.find((m) => slugOf(m.id) === slug))
  .filter((m): m is NonNullable<typeof m> => Boolean(m))

const copy = {
  en: {
    title: 'The machines your parts run on.',
    body: `${all.length} machines in our workshop: vertical machining centres from Doosan and Kovosvit MAS, an Intos CNC milling machine, CNC lathes from Trens and an Eastar slotting machine.`,
    cta: `All ${all.length} machines`,
    cols: ['No.', 'Machine', 'Type', 'Maker'],
  },
  sk: {
    title: 'Stroje, na ktorých vznikajú vaše diely.',
    body: `${all.length} strojov v našej prevádzke: vertikálne obrábacie centrá Doosan a Kovosvit MAS, CNC frézka Intos, CNC sústruhy Trens a obrážačka Eastar.`,
    cta: `Všetkých ${all.length} strojov`,
    cols: ['Č.', 'Stroj', 'Typ', 'Výrobca'],
  },
}

const t = copy[locale]
const machinesPath = localizedPath(locale, 'machines')
---

<section class="sheet" aria-labelledby="machines-title">
  <SheetRule folio={3} />
  <div class="frame">
    <div class="grid-12 items-end gap-y-6">
      <div class="col-span-12 lg:col-span-7">
        <h2 id="machines-title" class="headline">{t.title}</h2>
        <p class="lead mt-6 max-w-2xl">{t.body}</p>
      </div>
      <div class="col-span-12 lg:col-span-5 lg:justify-self-end">
        <a href={machinesPath} class="btn btn-line">
          {t.cta}
          <Arrow />
        </a>
      </div>
    </div>

    <div class="idx-head" aria-hidden="true">
      <span></span><span>{t.cols[0]}</span><span>{t.cols[1]}</span><span>{t.cols[2]}</span><span>{t.cols[3]}</span><span></span>
    </div>
    <ul class="idx">
      {
        featured.map((m) => {
          const slug = slugOf(m.id)
          const n = machineOrder.indexOf(slug) + 1
          return (
            <li id={`home-${slug}`}>
              <details name="home-machine">
                <summary class="idx-row">
                  <span class="idx-thumb">
                    <Image src={m.data.avatar.src} alt="" width={160} height={120} fit="contain" loading="lazy" class="plate" />
                  </span>
                  <span class="idx-no num">{String(n).padStart(2, '0')}</span>
                  <span class="idx-name">{m.data.name}</span>
                  <span class="idx-type">{typeOnly(m.data.title)}</span>
                  <span class="idx-maker">{machineFacts[slug].maker ?? '—'}</span>
                  <Arrow class="idx-arrow" dir="down" />
                </summary>
                <MachineSpec item={m} slug={slug} n={n} locale={locale} />
              </details>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>

<style>
  .idx-head,
  .idx-row {
    display: grid;
    grid-template-columns: 72px 2rem minmax(0, 1fr) 20px;
    column-gap: var(--gutter);
    align-items: center;
  }

  .idx-head {
    display: none;
    margin-top: clamp(32px, 4vw, 56px);
    padding-bottom: 10px;
    font-size: var(--text-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .idx {
    margin-top: clamp(32px, 4vw, 56px);
    border-top: var(--rule);
  }

  .idx li {
    border-bottom: var(--soft);
    scroll-margin-top: 96px;
  }

  .idx li:last-child {
    border-bottom: 0;
  }

  .idx-row {
    list-style: none;
    cursor: pointer;
    padding: 10px 0;
    color: var(--color-ink);
  }

  .idx-row::-webkit-details-marker {
    display: none;
  }

  .idx-row:hover .idx-name,
  details[open] .idx-name {
    color: var(--color-red);
  }

  /* Closed rows nudge their down arrow on hover; an open row's arrow points up and stays put. */
  details:not([open]) > .idx-row:hover :global(.idx-arrow) {
    transform: translateY(3px);
  }

  details[open] .idx-row :global(.idx-arrow) {
    rotate: -90deg !important;
  }

  .idx-thumb {
    grid-row: 1 / 3;
    height: 54px;
    display: grid;
    place-items: center;
  }

  .idx-thumb :global(img) {
    height: 54px;
    width: 72px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .idx-no {
    grid-row: 1 / 3;
    font-weight: 700;
  }

  .idx-name {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }

  .idx-type {
    grid-column: 3;
    font-size: var(--text-small);
    color: var(--color-mid);
  }

  .idx-maker {
    display: none;
  }

  .idx-row :global(.idx-arrow) {
    grid-column: 4;
    grid-row: 1 / 3;
    transition:
      transform 160ms ease-out,
      rotate 200ms ease-out;
  }

  @media (min-width: 900px) {
    .idx-head {
      display: grid;
    }

    /* The column head is only shown here, so only here does the list tuck under it. */
    .idx-head + .idx {
      margin-top: 0;
    }

    .idx-head,
    .idx-row {
      grid-template-columns: 72px 2.5rem minmax(0, 3fr) minmax(0, 4fr) minmax(0, 1.4fr) 20px;
    }

    .idx-thumb,
    .idx-no,
    .idx-row :global(.idx-arrow) {
      grid-row: auto;
    }

    .idx-type {
      grid-column: auto;
    }

    .idx-maker {
      display: block;
      font-size: var(--text-small);
      font-weight: 600;
    }

    .idx-row :global(.idx-arrow) {
      grid-column: 6;
    }
  }
</style>
