---
import Arrow from './ui/arrow.astro'
import Intake from './ui/intake.astro'
import SheetRule from './ui/sheetRule.astro'
import { company, telHref, mailHref } from '../data/company'

const { contact, locale: rawLocale } = Astro.props
const locale = rawLocale === 'en' ? 'en' : 'sk'

const copy = {
  sk: {
    lead: 'Pošlite výkres alebo zavolajte priamo do výroby. Hovoríte s ľuďmi, ktorí diel vyrobia.',
    peopleTitle: 'Ľudia',
    general: 'Všeobecné',
    hours: 'Pracovná doba',
    address: 'Sídlo a prevádzka',
    ids: { ico: 'IČO', dic: 'DIČ' },
    mapTitle: 'Mapa: Švehla a Blaško s.r.o., Nové Mesto nad Váhom',
    openMap: 'Otvoriť v Mapách Google',
  },
  en: {
    lead: 'Send a drawing or call production directly. You speak with the people who make the part.',
    peopleTitle: 'People',
    general: 'General enquiries',
    hours: 'Office hours',
    address: 'Registered office and workshop',
    ids: { ico: 'Company ID (IČO)', dic: 'VAT ID (DIČ)' },
    mapTitle: 'Map: Švehla a Blaško s.r.o., Nové Mesto nad Váhom',
    openMap: 'Open in Google Maps',
  },
}

const t = copy[locale]
// One directory for every route, directly under the intake, so the people read as part of it.
const people = [company.production, company.owner, company.director]
---

<section class="sheet-first">
  <SheetRule folio={1} />
  <div class="frame grid-12 gap-y-6">
    <div class="col-span-12 lg:col-span-7">
      <h1 class="display page-title">{contact.data.title}</h1>
      <p class="lead mt-6">{t.lead}</p>
    </div>
  </div>

  <div class="frame intake-wrap">
    <Intake allContacts={false} note="brief" />
  </div>

  <div class="frame people">
    <h2 class="label">{t.peopleTitle}</h2>
    <ul class="ledger">
      {
        people.map((p) => (
          <li class="row">
            <div>
              <p class="name">{p.name}</p>
              <p class="mt-1 text-mid">{p.role[locale]}</p>
            </div>
            <a href={telHref(p.phone)} class="phone num">{p.phone}</a>
            {p.email ? <a href={mailHref(p.email)} class="mail">{p.email}</a> : <span class="phone-empty" aria-hidden="true" />}
          </li>
        ))
      }
      <li class="row">
        <div>
          <p class="name">{t.general}</p>
          <p class="mt-1 text-mid">
            {t.hours}: <span class="num whitespace-nowrap">{company.hours[locale]}</span>
          </p>
        </div>
        <span class="phone-empty" aria-hidden="true"></span>
        <a href={mailHref(company.email)} class="mail">{company.email}</a>
      </li>
    </ul>
  </div>
</section>

<section class="sheet" aria-labelledby="address-title">
  <SheetRule folio={2} />
  <div class="frame grid-12 gap-y-10">
    <div class="col-span-12 lg:col-span-4">
      <h2 id="address-title" class="label">{t.address}</h2>
      <div class="ledger pt-5">
        <address class="not-italic leading-relaxed">
          <strong>{company.legalName}</strong><br />
          {company.address.street}<br />
          {company.address.city}<br />
          {company.address.country[locale]}
        </address>
        <dl class="mt-3 text-mid num">
          <div><dt class="inline">{t.ids.ico}:</dt> <dd class="inline">{company.ids.ico}</dd></div>
          <div><dt class="inline">{t.ids.dic}:</dt> <dd class="inline">{company.ids.dic}</dd></div>
        </dl>
      </div>
    </div>

    <figure class="map col-span-12 m-0 lg:col-span-8 lg:col-start-5">
      <div class="map-box">
        <iframe
          src={company.mapsEmbed}
          title={t.mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <figcaption>
        <a href={company.mapsLink} rel="noopener" target="_blank">
          {t.openMap}
          <Arrow dir="up-right" />
        </a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .page-title {
    font-size: var(--text-page-title);
  }

  .intake-wrap {
    margin-top: clamp(32px, 4vw, 56px);
  }

  /* On a white sheet the note lines up with the frame edge, like the rest of the page. */
  .intake-wrap :global(.note) {
    padding-inline: 0;
  }

  .people {
    margin-top: clamp(28px, 3vw, 44px);
  }

  .ledger {
    margin-top: 10px;
    border-top: var(--rule);
  }

  .row {
    display: grid;
    gap: 10px;
    padding: 20px 0;
    border-bottom: var(--soft);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .name {
    font-size: var(--text-title);
    font-weight: 750;
    font-stretch: 112%;
  }

  .phone,
  .mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .phone {
    white-space: nowrap;
    font-size: var(--text-figure);
    font-weight: 800;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .phone:hover {
    text-decoration-color: var(--color-red);
  }

  .mail {
    color: var(--color-ink);
  }

  .mail:hover {
    color: var(--color-red);
    text-decoration: underline;
  }

  .map {
    border: var(--hair);
  }

  .map-box {
    aspect-ratio: 4 / 3;
    background: var(--color-stone);
  }

  .map-box iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map figcaption {
    border-top: var(--hair);
  }

  .map figcaption a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .map figcaption a:hover {
    background: var(--color-ink);
    color: #fff;
  }

  .phone-empty {
    display: none;
  }

  /* Name on the left half, phone and email on the right half, so the phones sit under the
     intake's call cell. The extra half gutter matches that cell's hairline-plus-padding inset. */
  @media (min-width: 768px) {
    .row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 2fr);
      gap: var(--gutter);
      align-items: center;
    }

    .row > :nth-child(2) {
      padding-left: calc(var(--gutter) / 2);
    }

    .phone-empty {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .map-box {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .map-box {
      aspect-ratio: 21 / 9;
    }
  }
</style>
