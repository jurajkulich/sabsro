---
import '../styles/global.css'
import { SEO } from 'astro-seo'
import Footer from '@components/footer.astro'
import Navbar from '@components/navbar/navbar.astro'
import { getLocale } from 'astro-i18n-aut'
import { company } from '../data/company'

export interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  type?: 'website' | 'article'
  schema?: Record<string, unknown> | Record<string, unknown>[]
}

const locale = getLocale(Astro.url)
const siteName = 'Švehla a Blaško'
const siteURL = Astro.site ?? new URL(Astro.url.origin)
const ogLocale = locale === 'sk' ? 'sk_SK' : 'en_US'
const ogImageAlt = locale === 'sk' ? `${siteName}, strojárska dielňa` : `${siteName} machining workshop`
const localeAlternate = locale === 'sk' ? ['en_US'] : ['sk_SK']
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '')
const defaultLocale = 'sk'
const routePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || '/'
  : Astro.url.pathname
const cleanRoutePath = routePath
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/\/+$/, '') || '/'
const normalizedRoutePath = cleanRoutePath.replace(/^\/(en|sk)(?=\/|$)/, '') || '/'
// The default-locale home keeps its trailing slash: a base-path root without it 301s on GitHub Pages.
const localizedPath = (lang: string) =>
  lang === defaultLocale
    ? `${basePath}${normalizedRoutePath === '/' ? '/' : normalizedRoutePath}`
    : `${basePath}/${lang}${normalizedRoutePath === '/' ? '' : normalizedRoutePath}`
const canonicalURL = new URL(localizedPath(locale), siteURL).toString()
const languageAlternates = ['sk', 'en'].map((lang) => ({
  href: new URL(localizedPath(lang), siteURL).toString(),
  hrefLang: lang,
}))
const withBasePath = (path: string) => {
  if (/^https?:\/\//i.test(path)) return path
  const normalizedPath = path.startsWith('/') ? path : `/${path}`
  if (basePath && (normalizedPath === basePath || normalizedPath.startsWith(`${basePath}/`))) {
    return normalizedPath
  }
  return `${basePath}${normalizedPath}`
}

const defaultDescription =
  locale === 'en'
    ? 'Family-run CNC milling and turning in Slovakia. Prototypes and small series, short lead times and an inspection report with every batch.'
    : 'Rodinná firma pre CNC frézovanie a sústruženie na Slovensku. Prototypy a menšie série, krátke dodacie termíny a protokol z kontroly ku každej sérii.'

const {
  title = '',
  description = defaultDescription,
  image = '/opengraph.jpg',
  noindex = false,
  type = 'website',
  schema,
} = Astro.props

const resolvedImageWithDomain = new URL(withBasePath(image), siteURL).toString()
const makeTitle = title
  ? `${title} | ${siteName}`
  : locale === 'en'
    ? `${siteName} - Metalworking`
    : `${siteName} - Kovoobrábanie`

const homeURL = new URL(`${basePath}/`, siteURL).toString()
const services =
  locale === 'en'
    ? ['CNC milling', 'CNC turning', 'Drilling and tapping', 'Conventional milling', 'Band-saw cutting', 'Welding']
    : ['CNC frézovanie', 'CNC sústruženie', 'Vŕtanie a rezanie závitov', 'Konvenčné frézovanie', 'Delenie materiálu na pásových pílach', 'Zváranie']

// Confirmed facts only (PRODUCT.md › Operating Context, Capabilities). No ratings, geo or languages until supplied.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${homeURL}#organization`,
  name: company.legalName,
  alternateName: siteName,
  url: homeURL,
  logo: new URL(withBasePath('/favicon.svg'), siteURL).toString(),
  image: resolvedImageWithDomain,
  description: defaultDescription,
  email: company.email,
  telephone: company.owner.phone,
  vatID: company.ids.dic,
  identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: company.ids.ico },
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    postalCode: '915 01',
    addressLocality: 'Nové Mesto nad Váhom',
    addressCountry: 'SK',
  },
  hasMap: company.mapsLink,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '07:00',
    closes: '15:30',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: locale === 'en' ? 'quotes and business' : 'cenové ponuky a obchod',
      name: company.owner.name,
      email: company.owner.email,
      telephone: company.owner.phone,
    },
    {
      '@type': 'ContactPoint',
      contactType: locale === 'en' ? 'production' : 'výroba',
      name: company.director.name,
      email: company.director.email,
      telephone: company.director.phone,
    },
  ],
  makesOffer: services.map((name) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name },
  })),
}
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeURL}#website`,
  name: siteName,
  url: homeURL,
  inLanguage: ['sk', 'en'],
  publisher: { '@id': `${homeURL}#organization` },
}
const structuredData = [
  organizationSchema,
  websiteSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="alternate icon" type="image/x-icon" href={withBasePath('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={makeTitle}
      description={description}
      canonical={noindex ? null : canonicalURL}
      noindex={noindex}
      languageAlternates={noindex ? undefined : languageAlternates}
      openGraph={{
        basic: {
          title: makeTitle,
          type,
          image: resolvedImageWithDomain,
          url: canonicalURL,
        },
        optional: {
          description,
          locale: ogLocale,
          localeAlternate,
          siteName,
        },
        image: {
          alt: ogImageAlt,
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: makeTitle,
        description,
        image: resolvedImageWithDomain,
        imageAlt: ogImageAlt,
      }}
    />
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(localizedPath(defaultLocale), siteURL).toString()}
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-white font-sans text-ink">
    <a href="#main" class="skip-link">{locale === 'en' ? 'Skip to content' : 'Preskočiť na obsah'}</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body><style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--color-ink);
    color: #fff;
    padding: 12px 16px;
    font-weight: 700;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
</html>
